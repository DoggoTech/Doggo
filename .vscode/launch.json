{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Doggo (Chrome)",
      "request": "launch",
      "type": "dart",
      "deviceId": "chrome",
      "args": ["--dart-define-from-file=env.json"]
    },
    {
      "name": "Doggo (celular en Chrome)",
      "request": "launch",
      "type": "dart",
      "deviceId": "chrome",
      "args": [
        "--dart-define-from-file=env.json",
        "--web-browser-flag=--window-size=410,900"
      ]
    },
    {
      "name": "Doggo (emulador Android)",
      "request": "launch",
      "type": "dart",
      "deviceId": "emulator",
      "args": ["--dart-define-from-file=env.json"]
    }
  ]
}
